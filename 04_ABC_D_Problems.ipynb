    "H = int(input())\n",
    "count = 0\n",
    "ans = 1\n",
    "\n",
    "while H != 1:\n",
    "  H //= 2\n",
    "  count += 1\n",
    "  ans += (2**count)\n",
    "\n",
    "print(ans)"
